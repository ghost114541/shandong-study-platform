{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "知卷 KnowPaper（测试版）",
  "version": "0.2.0",
  "mainBinaryName": "knowpaper-preview",
  "identifier": "org.shandong-study.knowpaper-preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "知卷 KnowPaper（测试版） 0.2.0", "width": 1120, "height": 800, "minWidth": 550, "minHeight": 450 }],
    "security": {
      "capabilities": [{
        "identifier": "editor-window-close",
        "windows": ["main"],
        "permissions": ["core:event:allow-listen", "core:event:allow-unlisten", "core:window:allow-destroy"]
      }],
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' blob:; connect-src 'self' ws://127.0.0.1:1420 ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "KnowPaper",
    "icon": ["icons/icon.ico"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "currentUser",
        "compression": "zlib",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "template": "windows/preview-installer.nsi",
        "installerHooks": "windows/preview-guards.nsh"
      }
    }
  }
}
